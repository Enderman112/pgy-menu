{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PGYMenu",
  "version": "1.0.1",
  "identifier": "com.xuyaoshi.pgymenu",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "PGY 随身 WiFi",
        "url": "panel.html",
        "width": 364,
        "height": 596,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "PGY 随身 WiFi 设置",
        "url": "settings.html",
        "width": 940,
        "height": 700,
        "visible": false,
        "resizable": true,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
